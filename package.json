{
  "name": "meshwork",
  "productName": "Meshwork",
  "version": "0.1.0",
  "private": true,
  "description": "A local task workspace for people and AI agents",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.cjs",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "pnpm build && pnpm start",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build && esbuild src/main/index.ts src/preload/index.ts --bundle --platform=node --target=node24 --format=cjs --external:electron --outdir=dist --outbase=src --out-extension:.js=.cjs",
    "test": "node --disable-warning=ExperimentalWarning --test --experimental-strip-types tests/*.test.ts"
  },
  "dependencies": {
    "lucide-react": "^1.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.5.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  }
}
